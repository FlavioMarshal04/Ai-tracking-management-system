# Backend Environment Variables
NODE_ENV="development"
PORT=4000

# PostgreSQL Connection String (used by Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/edupulse?schema=public"

# Authentication Security
JWT_SECRET="your-256-bit-secret-key-change-in-production"

# CORS and Client Endpoints
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# AI Provider Configuration (gemini or sample)
AI_PROVIDER="sample"
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# File Upload Storage
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Optional S3-compatible cloud storage
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
